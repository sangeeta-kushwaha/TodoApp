PORT=8080
MONGO_URI=mongodb://localhost:27017/auth-app
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
NODE_ENV=development

# Use false with http://localhost. Set true when the site is served over HTTPS.
COOKIE_SECURE=false
# Use lax when the frontend and API share a site. Use none for separate HTTPS sites.
COOKIE_SAMESITE=lax
